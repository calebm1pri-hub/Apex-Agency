# ─────────────────────────────────────────────────────────────
# Marnie — environment variables
# Copy to `.env.local` and fill in. The app runs fully WITHOUT any of these
# (mock data + demo mode); each service turns "live" as you add its keys.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, OG, referral links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Auth (NextAuth / Auth.js v5) ──
# Generate: `openssl rand -base64 32`
AUTH_SECRET=
# Optional OAuth (add the providers in src/auth.ts to use these)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ── Shopify Storefront (powers products; enables TikTok Shop sync) ──
# Without these, the mock catalog in src/lib/products.ts is served.
SHOPIFY_STORE_DOMAIN=            # e.g. marnie.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=

# ── Stripe (payments) ──
# Without these, checkout runs in demo mode (no charge).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Supabase (creators, referrals, UGC, loyalty, subscribers) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-only; never expose to the browser

# ── Klaviyo (email/SMS flows: welcome, abandoned cart, post-purchase) ──
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=

# ── TikTok ──
NEXT_PUBLIC_TIKTOK_PIXEL_ID=     # enables the on-site TikTok Pixel

# ── Zapier / Make / n8n automation webhooks (optional, per workflow) ──
ZAP_NEW_ORDER_URL=
ZAP_CREATOR_APPLIED_URL=
ZAP_UGC_UPLOADED_URL=
ZAP_SEEDANCE_URL=
ZAP_OUTREACH_URL=
